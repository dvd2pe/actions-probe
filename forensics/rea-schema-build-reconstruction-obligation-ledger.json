                        architecture:
                          anyOf[2]:
                            - type: string
                              enum[10]: x86,x86_64,arm,arm64,arm64_32,mips,riscv,powerpc,hexagon,xtensa
                            - type: "null"
                      required[3]: digest,format,architecture
                      additionalProperties: false
                    - type: object
                      properties:
                        digest:
                          type: object
                          properties:
                            sha256:
                              type: string
                              pattern: "^[a-f0-9]{64}$"
                          required[1]: sha256
                          additionalProperties: false
                        format:
                          type: string
                          const: raw-binary
                        architecture:
                          anyOf[2]:
                            - type: string
                              enum[12]: "6502",x86,x86_64,arm,arm64,arm64_32,mips,riscv,powerpc,m68k,hexagon,xtensa
                            - type: "null"
                      required[3]: digest,format,architecture
                      additionalProperties: false
                    - type: object
                      properties:
                        digest:
                          type: object
                          properties:
                            sha256:
                              type: string
                              pattern: "^[a-f0-9]{64}$"
                          required[1]: sha256
                          additionalProperties: false
                        format:
                          type: string
                          const: gamecube-dol
                        architecture:
                          type: string
                          const: powerpc
                      required[3]: digest,format,architecture
                      additionalProperties: false
              providers:
                type: array
                items:
                  type: object
                  properties:
                    id:
                      type: string
                      minLength: 1
                    name:
                      type: string
                      minLength: 1
                    version:
                      type[2]: string,"null"
